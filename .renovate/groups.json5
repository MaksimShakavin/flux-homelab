{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "1Password Connect Group",
      groupName: "1password-connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Dragonfly Operator Group",
      groupName: "Dragonfly Operator",
      matchPackageNames: ["/dragonfly(?:db)?.operator/"],
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      separateMinorPatch: true,
    },
    {
      description: "Securo Group",
      groupName: "securo",
      matchDatasources: ["docker"],
      matchPackageNames: ["/securo-finance//"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Immich Group",
      groupName: "immich",
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich-app//"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Talos version lives in 3 places tracked as 2 deps: talconfig.yaml
      // (custom.talos-factory / siderolabs/talos) and tuppr talosupgrade.yaml
      // + talos.tofu (docker / ghcr.io/siderolabs/installer). Group so every
      // Talos bump lands in one coordinated PR.
      description: "Talos Group",
      groupName: "Talos",
      matchDatasources: ["docker", "custom.talos-factory"],
      matchPackageNames: ["ghcr.io/siderolabs/installer", "siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
