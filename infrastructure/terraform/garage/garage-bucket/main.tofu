terraform {
  required_providers {
    garage = {
      source = "arsolitt/garagehq"
    }
  }
}

resource "garage_bucket" "bucket" {
  global_alias = var.bucket_name
}

# Keys are generated by Garage (Arsolitt provider cannot import pre-made keys).
# The secret is only returned at creation time; consume it via this module's
# outputs and store it in the secrets manager if a consumer needs it.
resource "garage_key" "key" {
  name = "${var.bucket_name}-key"
}

resource "garage_bucket_key" "key_rw" {
  bucket_id     = garage_bucket.bucket.id
  access_key_id = garage_key.key.access_key_id
  read          = true
  write         = true
  owner         = true
}
