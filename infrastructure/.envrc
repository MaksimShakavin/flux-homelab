use_sops() {
    local path=${1:-$PWD/secrets.sops.yaml}
    eval "$(sops -d --output-type dotenv "$path" | direnv dotenv bash /dev/stdin)"
    watch_file "$path"
}

source_up
# will load secrets.yaml
use sops

export AWS_ACCESS_KEY_ID="$(op read 'op://homelab/garage-buckets/terraform/terraform_AWS_ACCESS_KEY_ID')"
export AWS_SECRET_ACCESS_KEY="$(op read 'op://homelab/garage-buckets/terraform/terraform_AWS_SECRET_ACCESS_KEY')"
