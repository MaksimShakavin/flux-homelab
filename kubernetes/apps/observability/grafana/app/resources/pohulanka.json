    {
      "id": 12,
      "type": "state-timeline",
      "title": "Air quality index",
      "description": "Air-quality rating per sensor. 1 Отличное · 2 Хорошее · 3 Приемлемое · 4 Низкое · 5 Плохое. Ikea sensors (Living Room, Study) report two ratings — by PM2.5 and by VOC; WB sensors (Bedroom, Bathroom) report one, by VOC.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VICTORIAMETRICS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#37872D",
                "value": null
              },
              {
                "color": "#56A64B",
                "value": 2
              },
              {
                "color": "#F2CC0C",
                "value": 3
              },
              {
                "color": "#FF9830",
                "value": 4
              },
              {
                "color": "#E02F44",
                "value": 5
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Отличное",
                  "index": 0
                },
                "2": {
                  "text": "Хорошее",
                  "index": 1
                },
                "3": {
                  "text": "Приемлемое",
                  "index": 2
                },
                "4": {
                  "text": "Низкое",
                  "index": 3
                },
                "5": {
                  "text": "Плохое",
                  "index": 4
                }
              }
            }
          ],
          "min": 1,
          "max": 5
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
